# Copy to your shell / MCP client env. This file is documentation only:
# the server does not load .env automatically.
#
# The server speaks MCP over stdio only. The one startup knob is log verbosity:
#   python -m mcp_comm_server --log-level DEBUG

# --- logging -----------------------------------------------------------------
MCP_COMM_LOG_LEVEL=INFO

# --- serial defaults (reserved for a later milestone) ------------------------
# MCP_COMM_DEFAULT_BAUDRATE=9600
# MCP_COMM_DEFAULT_TIMEOUT=1.0
# MCP_COMM_MAX_READ_BYTES=1048576
# MCP_COMM_ALLOWED_PORTS=COM3,COM4
